---
import Layout from "../layouts/layout.astro";
import AffiliateButton from "../components/AffiliateButton.astro";
import { base, withBase } from "../utils/base";
import { getCollection } from "astro:content";

const reviews = await getCollection("reviews");
const sorted = [...reviews].sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const potw = sorted.find((r) => r.data.productOfTheWeek) ?? sorted[0];
const gridReviews =
	potw != null ? sorted.filter((r) => r.id !== potw.id) : sorted;

const fmt = new Intl.DateTimeFormat("en-US", {
	month: "short",
	day: "numeric",
	year: "numeric",
});

const pageDesc =
	"Labor-tested gear picks with honest pros, cons, and quick Amazon affiliate links.";
---

<Layout
	title="The Curated Grid — Product picks & Amazon reviews"
	description={pageDesc}
>
	<div class="border-b border-zinc-200/80 bg-white/70 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/70">
		<header class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-5 sm:px-6 lg:px-8">
			<a href={base} class="font-mono text-sm tracking-tight text-zinc-900 dark:text-zinc-100">
				<span class="text-zinc-500 dark:text-zinc-400">the</span>
				<span class="font-semibold">curated</span>
				<span class="text-zinc-500 dark:text-zinc-400">.grid</span>
			</a>
			<nav aria-label="Main" class="flex items-center gap-6 text-sm">
				<a
					class="text-zinc-600 transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white"
					href={`${base}#reviews`}
				>
					Latest reviews
				</a>
			</nav>
		</header>
	</div>

	<main>
		{potw && (
			<section
				class="relative overflow-hidden border-b border-zinc-200 dark:border-zinc-800"
				aria-labelledby="potw-heading"
			>
				<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-teal-500/10 via-transparent to-transparent dark:from-teal-400/15" />
				<div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
					<p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-teal-600 dark:text-teal-400">
						Product of the week
					</p>
					<h1
						id="potw-heading"
						class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-zinc-900 dark:text-white sm:text-4xl lg:text-5xl"
					>
						{potw.data.title}
					</h1>
					<p class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
						{potw.data.description}
					</p>

					<div class="mt-10 flex flex-col gap-6 sm:flex-row sm:items-center">
						<AffiliateButton href={potw.data.affiliateUrl} />
						<a
							href={withBase(`reviews/${potw.data.slug}/`)}
							class="font-mono text-sm text-teal-700 underline-offset-4 hover:text-teal-600 hover:underline dark:text-teal-400 dark:hover:text-teal-300"
						>
							Read full review →
						</a>
					</div>
				</div>
			</section>
		)}

		<section id="reviews" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20" aria-labelledby="reviews-heading">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<h2
						id="reviews-heading"
						class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-white"
					>
						Latest reviews
					</h2>
					<p class="mt-2 max-w-xl text-sm text-zinc-600 dark:text-zinc-400">
						Short verdicts backed by extended write-ups — updated as we rotate new gear through testing.
					</p>
				</div>
			</div>

			<ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{gridReviews.map((r) => (
					<li>
						<article class="flex h-full flex-col rounded-xl border border-zinc-200/90 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900/50">
							<div class="flex items-center justify-between gap-3 font-mono text-xs text-zinc-500 dark:text-zinc-500">
								<span>{fmt.format(r.data.pubDate)}</span>
								{r.data.category && (
									<span class="rounded-md border border-zinc-200 px-2 py-0.5 dark:border-zinc-700">
										{r.data.category}
									</span>
								)}
							</div>
							<h3 class="mt-4 text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">
								<a
									href={withBase(`reviews/${r.data.slug}/`)}
									class="transition-colors hover:text-teal-700 dark:hover:text-teal-400"
								>
									{r.data.title}
								</a>
							</h3>
							<p class="mt-2 grow text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
								{r.data.excerpt ?? r.data.description}
							</p>
							<div class="mt-6 flex flex-wrap items-center gap-4">
								<AffiliateButton href={r.data.affiliateUrl} class="!px-4 !py-2.5 !text-xs" />
								<a
									href={withBase(`reviews/${r.data.slug}/`)}
									class="text-sm font-medium text-zinc-700 underline-offset-4 hover:underline dark:text-zinc-300"
								>
									Review
								</a>
							</div>
						</article>
					</li>
				))}
			</ul>
		</section>
	</main>

	<footer class="border-t border-zinc-200 py-10 dark:border-zinc-800">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<p class="max-w-2xl text-center text-xs leading-relaxed text-zinc-500 dark:text-zinc-500">
				We may earn commissions from qualifying purchases made through retailer links on this site — at no extra cost to you. Editorial picks are independent of compensation.
			</p>
		</div>
	</footer>
</Layout>

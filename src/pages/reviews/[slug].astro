---
import Layout from "../../layouts/layout.astro";
import AffiliateButton from "../../components/AffiliateButton.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const reviews = await getCollection("reviews");
	return reviews.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

interface Props {
	entry: import("astro:content").CollectionEntry<"reviews">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const title = `${entry.data.title} — Review | The Curated Grid`;
const image = entry.data.image ?? "/og-default.svg";

const canonical = new URL(`/reviews/${entry.data.slug}/`, Astro.site ?? Astro.url);

const fmt = new Intl.DateTimeFormat("en-US", {
	month: "long",
	day: "numeric",
	year: "numeric",
});

const stars =
	entry.data.rating != null ? "★".repeat(entry.data.rating) + "☆".repeat(5 - entry.data.rating) : null;
---

<Layout
	title={title}
	description={entry.data.description}
	image={image}
	canonicalURL={canonical}
	ogType="article"
>
	<div class="border-b border-zinc-200/80 bg-white/70 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/70">
		<header class="mx-auto flex max-w-3xl items-center justify-between gap-6 px-4 py-5 sm:px-6 lg:px-8">
			<a href="/" class="font-mono text-sm tracking-tight text-zinc-900 dark:text-zinc-100">
				<span class="text-zinc-500 dark:text-zinc-400">←</span> curated.grid
			</a>
		</header>
	</div>

	<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<header class="border-b border-zinc-200 pb-10 dark:border-zinc-800">
			<div class="flex flex-wrap items-center gap-3 font-mono text-xs text-zinc-500 dark:text-zinc-500">
				<time datetime={entry.data.pubDate.toISOString()}>
					{fmt.format(entry.data.pubDate)}
				</time>
				{entry.data.category && (
					<>
						<span aria-hidden="true">·</span>
						<span>{entry.data.category}</span>
					</>
				)}
				{stars && (
					<>
						<span aria-hidden="true">·</span>
						<span class="tracking-tighter text-amber-500" aria-label={`Rated ${entry.data.rating} out of 5`}>
							{stars}
						</span>
					</>
				)}
			</div>

			<h1 class="mt-6 text-3xl font-semibold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
				{entry.data.title}
			</h1>
			<p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">
				{entry.data.description}
			</p>

			<div class="mt-8">
				<AffiliateButton href={entry.data.affiliateUrl} />
			</div>
		</header>

		<div class="review-content pb-16 pt-10">
			<Content />
		</div>
	</article>
</Layout>
